{
  "name": "laptime-insights-dev",

  // JS toolchain (fnm + Node, standalone pnpm, OpenSpec CLI) is built from the
  // Dockerfile — NOT corepack, matching the Strength project's approach. The
  // Dockerfile keeps the JDK-21 devcontainer base (Kotlin/Gradle needs the JVM),
  // so this replaces both the old `image` and the `node` Feature.
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Layered on top of the built image as Dev Container Features:
  //   - github-cli:  `gh` for PRs/issues and HTTPS git auth (`gh auth login`).
  //   - claude-code: the Claude Code CLI.
  // Node/pnpm come from the Dockerfile; the JDK comes from the base image.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // Static container name + a predictable `vscode@laptime-insights` prompt.
  // Caveat: only ONE orchestrator may own the name at a time; if a start fails
  // with a 409 / "name already in use", clear the stale one and rebuild:
  //     docker rm -f laptime-insights-dev
  "runArgs": ["--name", "laptime-insights-dev", "--hostname", "laptime-insights"],

  // 8000 = Ktor backend, 5173 = Vite frontend, 9092 = optional H2 TCP server.
  "forwardPorts": [8000, 5173, 9092],
  "portsAttributes": {
    "8000": { "label": "Backend (Ktor API + Swagger UI)", "onAutoForward": "notify" },
    "5173": { "label": "Frontend (Vite dev server)", "onAutoForward": "openBrowser" },
    "9092": { "label": "H2 TCP (optional)", "onAutoForward": "silent" }
  },

  // Sensible first-run defaults: in-memory H2 with sample data seeded, all
  // features on. Override any of these in your shell / launch config.
  "remoteEnv": {
    "JDBC_URL": "jdbc:h2:mem:laptimeinsights;DB_CLOSE_DELAY=-1",
    "DB_SEED": "true",
    "FEATURE_OVERVIEW": "true",
    "FEATURE_SESSIONS": "true",
    "FEATURE_LAPS": "true",
    "FEATURE_COMPARE": "true",
    "FEATURE_LIVE": "true"
  },

  // Persist caches across rebuilds so installs stay fast:
  //   - /cache  : shared with EVERY dev container on this machine, so a package
  //     or Gradle dependency downloads once per machine rather than once per
  //     project. Holds BOTH the pnpm store (/cache/pnpm-store) and the Gradle
  //     cache (/cache/gradle, via GRADLE_USER_HOME below). The source name is
  //     deliberately project-independent — renaming it per project silently
  //     un-shares the caches.
  //   - ms-playwright : the browsers, so a rebuild doesn't re-download ~539MB.
  //     Per project on purpose (a shared browser cache lets one project's
  //     `playwright install` GC another's).
  // NB: there is intentionally NO volume at ~/.local/share/pnpm (PNPM_HOME) —
  // the standalone pnpm binary is baked into the image there, and a volume would
  // shadow it. The old `laptime-insights-gradle` and `laptime-insights-pnpm`
  // volumes are now unused and can be deleted.
  "mounts": [
    "source=devcontainer-cache,target=/cache,type=volume",
    "source=laptime-insights-playwright,target=/home/vscode/.cache/ms-playwright,type=volume"
  ],

  // Pin Playwright to the volume above rather than its ~/.cache default
  // (containerEnv, not remoteEnv: a Playwright that can't see this var silently
  // downloads its own copy, bypassing the volume). Point Gradle at the shared
  // /cache/gradle (Gradle locks its home, so projects share it safely — like a
  // host's ~/.gradle). Opt out of OpenSpec's anonymous telemetry.
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.cache/ms-playwright",
    "GRADLE_USER_HOME": "/cache/gradle",
    "OPENSPEC_TELEMETRY": "0"
  },

  // One-time provisioning: chown the volumes, sync Node to .node-version, wire
  // git hooks, point pnpm at the shared store, install both frontends, warm the
  // Gradle build, and fetch the Playwright Chromium.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  // Editor-specific setup. VS Code reads `vscode`; JetBrains Gateway / IntelliJ
  // reads `jetbrains` (and ignores the other). Both open the SAME container.
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/usr/lib/jvm/msopenjdk-current",
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    },
    "jetbrains": {
      // IntelliJ IDEA (Ultimate) — this is a Kotlin/Gradle + React project, so
      // IDEA is the right JetBrains backend (WebStorm can't do Kotlin/Gradle).
      "backend": "IntelliJ",
      "plugins": [
        "intellij.prettierJS"
      ]
    }
  }
}
